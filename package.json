{
  "name": "vale-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env src/db/seed.js",
    "db:reset": "node --env-file-if-exists=.env src/db/reset.js",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
