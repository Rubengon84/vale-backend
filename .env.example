# Copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://vale:vale@localhost:5432/vale_dev

# Auth0: the tenant domain and the identifier of the "Vale API" you create in
# Auth0 > Applications > APIs. The front end must request the same audience.
AUTH0_DOMAIN=rubengon.eu.auth0.com
AUTH0_AUDIENCE=https://api.vale.example

# Front-end origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Times sent without an offset are read in this time zone
APP_TIMEZONE=Europe/Madrid

# Set to true when running behind a reverse proxy (Render, Heroku, nginx...)
TRUST_PROXY=false

# Secret for signing the temporary photo links. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMAGE_URL_SECRET=

# Requests per minute per IP address (people on the same Wi-Fi share one)
RATE_LIMIT_PER_MINUTE=600

# Front-end address, used for links in emails
APP_URL=http://localhost:3000

# Emails with Resend (resend.com). Without a key, emails are only logged.
RESEND_API_KEY=
# Until you verify a domain in Resend, use onboarding@resend.dev, which can
# only send to your own Resend account's email address.
EMAIL_FROM=VALE Conecta <onboarding@resend.dev>

# Secret for POST /internal/jobs (reminders and chat clean-up), called every
# hour by an external timer. Generate it like IMAGE_URL_SECRET.
CRON_SECRET=
