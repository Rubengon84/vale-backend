# Copy to .env and fill in. Never commit .env.

PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://vale:vale@localhost:5432/vale_dev

# Auth0: the tenant domain and the identifier of the "Vale API" you create in
# Auth0 > Applications > APIs. The front end must request the same audience.
AUTH0_DOMAIN=rubengon.eu.auth0.com
AUTH0_AUDIENCE=https://api.vale.example

# Front-end origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Times sent without an offset are read in this time zone
APP_TIMEZONE=Europe/Madrid

# Set to true when running behind a reverse proxy (Render, Heroku, nginx...)
TRUST_PROXY=false

# Secret for signing the temporary photo links. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IMAGE_URL_SECRET=
